[shared]
user_agent = "Mozilla/5.0 ..."
cookie_string_base64 = "b2FpLWRpZD0..."
# Optional: override default output locations (use ~ for home directory)
# history_folder = "~/data/chatgpt/image_history"
# image_folder = "~/Desktop/images"
# delete_library_queries = ["query1", "query2"]
# remove_all_library_images = false
# conversation_delay = 2.0  # seconds between conversations in sequential mode
